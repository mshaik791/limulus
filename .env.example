# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Load it with:  node --env-file=.env src/rails/selftest.ts

# Increase (https://dashboard.increase.com/developers/api_keys).
# Use the SANDBOX key. Its base URL is https://sandbox.increase.com and no real
# money moves. Without this, the rail falls back to a local stand-in and says so.
INCREASE_API_KEY=
# The sandbox account funds would leave from, from the Accounts page.
INCREASE_ACCOUNT_ID=
# Only set this to "production" deliberately. Anything else uses the sandbox.
INCREASE_ENV=sandbox

# Require an API key on every /v1 route except receipt verification.
LIMULUS_REQUIRE_AUTH=0
# Refuse to release for callers with no qualification.
LIMULUS_REQUIRE_QUALIFICATION=0

# Embeddable.com dashboard platform
EMBEDDABLE_API_KEY=
